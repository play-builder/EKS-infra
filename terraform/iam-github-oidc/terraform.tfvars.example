# Supported deployment Regions: ap-northeast-2 or us-east-1.
aws_region   = "ap-northeast-2"
project_name = "playdevops"
course_id    = "replace-with-unique-course-id"
github_org   = "play-builder"

# Use create only in a dedicated account without the GitHub issuer.
# Use external for an existing account-wide provider and set its exact ARN.
oidc_provider_mode         = "create"
external_oidc_provider_arn = null

infra_oidc_subjects = [
  "repo:play-builder@42942042/EKS-infra@405337777:ref:refs/heads/main",
]

sample_app_oidc_subjects = [
  "repo:play-builder@42942042/cicd-course-sample-app@1352247019:ref:refs/heads/main",
  "repo:play-builder@42942042/mini-commerce@1352247019:ref:refs/heads/main",
]

tags = {
  PlatformInstanceId = "replace-me"
  Owner = "platform-sre"
  CostCenter = "replace-me"
  Course = "cicd-gitops"
}
sample_app_attest_verify_oidc_subjects = [
  "repo:play-builder@42942042/cicd-course-sample-app@1352247019:ref:refs/heads/main",
  "repo:play-builder@42942042/mini-commerce@1352247019:ref:refs/heads/main",
]
mini_commerce_ecr_repository = "playdevops/mini-commerce"
mini_commerce_chart_ecr_repository = "playdevops/mini-commerce-chart"
ecr_registry_scanning = {
  ownership_mode = "external"
  scan_type = "ENHANCED"
  scan_frequency = "CONTINUOUS_SCAN"
  repository_filters = ["playdevops/sample-app*","playdevops/mini-commerce*","playdevops/platform/istio-proxyv2*"]
}
