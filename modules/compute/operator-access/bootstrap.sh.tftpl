#!/usr/bin/env bash
set -Eeuo pipefail

dnf install -y curl
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli-2
fi
architecture=$(uname -m)
case "$architecture" in
  x86_64) kubectl_arch=amd64 ;;
  aarch64) kubectl_arch=arm64 ;;
  *) echo "unsupported architecture: $architecture" >&2; exit 1 ;;
esac
kubectl_url="https://dl.k8s.io/release/v${kubectl_version}/bin/linux/$kubectl_arch/kubectl"
curl -fsSLo /var/lib/kubectl "$kubectl_url"
curl -fsSLo /var/lib/kubectl.sha256 "$kubectl_url.sha256"
echo "$(cat /var/lib/kubectl.sha256)  /var/lib/kubectl" | sha256sum --check
install -m 0755 /var/lib/kubectl /usr/local/bin/kubectl
aws --version
kubectl version --client=true
