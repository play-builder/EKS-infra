#     permissions_boundary_arn           = "arn:aws:iam::<DEV_ACCOUNT_ID>:policy/<REVIEWED_PLAN_BOUNDARY>"
#     permissions_boundary_policy_sha256 = "<SHA256_OF_CANONICAL_POLICY_JSON>"
#   }
#   apply = {
#     role_arn                           = "arn:aws:iam::<DEV_ACCOUNT_ID>:role/<REVIEWED_APPLY_ROLE>"
#     permissions_boundary_arn           = "arn:aws:iam::<DEV_ACCOUNT_ID>:policy/<REVIEWED_APPLY_BOUNDARY>"
#     permissions_boundary_policy_sha256 = "<SHA256_OF_CANONICAL_POLICY_JSON>"
#   }
#   drift = {
#     role_arn                           = "arn:aws:iam::<DEV_ACCOUNT_ID>:role/<REVIEWED_DRIFT_ROLE>"
#     permissions_boundary_arn           = "arn:aws:iam::<DEV_ACCOUNT_ID>:policy/<REVIEWED_DRIFT_BOUNDARY>"
#     permissions_boundary_policy_sha256 = "<SHA256_OF_CANONICAL_POLICY_JSON>"
#   }
# }
# environment=dev -> dev-plan / dev / dev-drift
# environment=prod -> production-plan / production / production-drift
# environment=recovery -> recovery-plan / recovery / recovery-drift
