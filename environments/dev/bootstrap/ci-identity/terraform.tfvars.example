aws_region        = "ap-northeast-2"
environment       = "dev"
project_name      = "mini-commerce"
state_bucket_name = "mini-commerce-tfstate-replace-with-dev-account-id"

github_owner          = "replace-with-github-owner"
github_owner_id       = "0"
infra_repository_name = "EKS-infra"
infra_repository_id   = "0"

oidc_provider_mode         = "create"
external_oidc_provider_arn = null

# No CI permissions by default. The legacy infra role is retired with DenyAll.
# Security/identity owners provision 3 separate roles, customer-managed boundaries and exact state/service policies.
# Supply a role mapping only after reviewing those policies; never reuse one apply role for plan/drift.
enable_external_ci_roles = false
external_ci_roles        = {}
