# Supported deployment Regions: ap-northeast-2 or us-east-1.
aws_region   = "ap-northeast-2"
project_name = "playdevops"
course_id    = "replace-with-unique-course-id"
environment  = "dev"
cluster_name = "dev-playdevops-eks"

# Resolve this value with aws eks describe-addon-versions for EKS 1.36 in the selected Region.
vpc_cni_addon_version                  = "REPLACE_WITH_COMPATIBLE_EKS_ADDON_VERSION"
vpc_cni_enable_network_policy          = false
vpc_cni_network_policy_enforcing_mode  = "standard"

cluster_version                            = "1.36"
authentication_mode                        = "API"
bootstrap_cluster_creator_admin_permissions = false
cluster_admin_principal_arns = [
  "arn:aws:iam::123456789012:role/AWSReservedSSO_AdministratorAccess_REPLACE_ME",
]

# Restrict public API access to the operator's /32; never use 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

enable_bastion            = false
enable_public_node_group  = false
enable_private_node_group = true

private_node_group_desired_size  = 2
private_node_group_min_size      = 2
private_node_group_max_size      = 4
private_node_group_instance_types = ["t3.large"]

# Required by the module even when the bastion is disabled; leave empty.
bastion_instance_keypair = ""
