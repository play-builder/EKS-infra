aws_region   = "ap-northeast-2"
project_name = "mini-commerce"
org_id       = "o-replaceme"

# Fork identity. Numeric IDs never change even if names do.
github_owner        = "replace-with-github-owner"
github_owner_id     = "0"
app_repository_name = "mini-commerce"
app_repository_id   = "0"

# create in a fresh account; external when the account already has token.actions.githubusercontent.com
oidc_provider_mode         = "create"
external_oidc_provider_arn = null

ecr_keep_last_images = 30

# Optional publisher. These GitHub IDs were verified from public metadata on 2026-09-08.
# Forks must replace all four GitHub identity fields; AWS account/region come from the operator.
# platform_image_publisher = {
#   github_owner        = "play-builder"
#   github_owner_id     = "42942042"
#   repository_name     = "EKS-infra"
#   repository_id       = "405337777"
#   ecr_repository_name = "mini-commerce-platform-istio-proxy"
# }

# External is the default: this root makes no registry-wide scanning changes.
# See docs/runbooks/platform-image-publishing.md before importing this account/region singleton.
registry_scanning = { ownership_mode = "external" }
