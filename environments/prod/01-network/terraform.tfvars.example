# Supported deployment Regions: ap-northeast-2 or us-east-1.
aws_region   = "ap-northeast-2"
project_name = "playdevops"
course_id    = "replace-with-unique-course-id"
environment  = "prod"
platform_instance_id = "replace-with-platform-instance-id"
owner                = "platform-sre"
cost_center          = "replace-with-cost-center"

# Never overlap the dev VPC CIDR. Non-overlap keeps future peering possible.
vpc_cidr = "10.1.0.0/16"

# Empty selects the first three standard AZs in aws_region. Set concrete AZ names only when an override is required.
availability_zones    = []
public_subnet_cidrs   = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
private_subnet_cidrs  = ["10.1.11.0/24", "10.1.12.0/24", "10.1.13.0/24"]
database_subnet_cidrs = ["10.1.21.0/24", "10.1.22.0/24", "10.1.23.0/24"]

production_nat_topology = "per_az"
enable_nat_gateway     = true
single_nat_gateway     = false
one_nat_gateway_per_az = true

enable_vpc_flow_logs           = true
vpc_flow_log_retention_in_days = 30
vpc_flow_log_kms_key_arn       = null
