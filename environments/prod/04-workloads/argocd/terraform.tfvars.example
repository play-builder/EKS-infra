# Supported course Regions: ap-northeast-2 or us-east-1.
aws_region   = "ap-northeast-2"
project_name = "playdevops"
course_id    = "replace-with-unique-course-id"
environment  = "prod"

gitops_repo_url        = "https://github.com/REPLACE_ME/argocd-gitops.git"
gitops_target_revision = "main"

# Keep false until DEV_READY and the prod repository access check are complete.
enable_bootstrap = false
